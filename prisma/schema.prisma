generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model HomeSettings {
  id                 Int       @id @default(autoincrement())
  hero_title         String?
  hero_description   String?
  promo_title        String?
  promo_description  String?
  created_at         DateTime? @default(now())
  updated_at         DateTime? @updatedAt

  @@map("home_settings")
}

model Progress {
  id          Int       @id @default(autoincrement())
  title       String
  youtube_url String
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt
  sort_order  Int       @default(0)

  @@index([sort_order], map: "progress_sort_order_index")
  @@map("progress")
}

model ProjectImages {
  id         Int       @id @default(autoincrement())
  project_id Int
  image_path String
  caption    String?
  sort_order Int       @default(0)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  projects   Projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([project_id, sort_order], map: "project_images_project_id_sort_order_index")
  @@map("project_images")
}

model Projects {
  id                Int       @id @default(autoincrement())
  name              String
  category          String    @default("rumah")
  slug              String    @unique(map: "projects_slug_unique")
  short_description String?
  features          String?
  location          String?
  maps_url          String?
  cover_image       String?
  brochure_file     String?
  is_promo          Boolean   @default(false)
  whatsapp_number   String?
  meta_title        String?
  meta_description  String?
  youtube_url       String?
  gmaps_url         String?
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt
  sort_order        Int       @default(0)

  project_images    ProjectImages[]

  @@index([is_promo], map: "projects_is_promo_index")
  @@index([slug], map: "projects_slug_index")
  @@index([sort_order], map: "projects_sort_order_index")
  @@map("projects")
}

model SiteSettings {
  id                    Int       @id @default(autoincrement())
  sales_whatsapp_number String?
  site_name             String    @default("PIK 2 OFFICIAL")
  site_tagline          String    @default("Katalog Properti & Hunian Pilihan di PIK 2")
  topbar_label          String    @default("Sales Property")
  created_at            DateTime? @default(now())
  updated_at            DateTime? @updatedAt

  @@map("site_settings")
}
